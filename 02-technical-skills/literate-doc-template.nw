% 2. API & Contracts
% -----------------------------------------------------------------------------

Below are the public APIs, presented with their contracts.

<<api.h>>=
#ifndef <<MODULE_UPPER>>_H
#define <<MODULE_UPPER>>_H

#include <stdint.h>
#include <stdbool.h>

/* Initialize the module. Must be called once before any other calls. */
int <<module_prefix>>_init(void);

/* Read data into buffer. Precondition: buf != NULL and len >= MIN_LEN. */
int <<module_prefix>>_read(uint8_t *buf, unsigned len);

/* Shutdown / put into low-power mode. */
void <<module_prefix>>_shutdown(void);

#endif /* <<MODULE_UPPER>>_H */
@

For each function above, state explicitly:
- Pre-conditions
- Post-conditions
- Error codes and meaning
- Timing constraints (if any)

Example (for <<module_prefix>>_read):
- pre: buffer != NULL, len >= 8
- post: return 0 on success, buffer filled with len bytes
- errors: -1 = timeout, -2 = hardware fault
- worst-case time: 2 ms per byte (approx.)

% -----------------------------------------------------------------------------
% 3. Minimal usage example
% -----------------------------------------------------------------------------

A minimal example demonstrating initialization, usage, and shutdown.

<<example_main.c>>=
#include "<<module_name>>.h"
#include <stdio.h>

int main(void) {
  if (<<module_prefix>>_init() != 0) {
    printf("init fail\n");
    return -1;
  }

  uint8_t buf[16];
  if (<<module_prefix>>_read(buf, sizeof(buf)) == 0) {
    /* handle data */
  }

  <<module_prefix>>_shutdown();
  return 0;
}
@

